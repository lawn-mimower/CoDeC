# Copy this file to .env.local and fill the values. Do NOT commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# If you need a server-side service role key, store it as SUPABASE_SERVICE_ROLE_KEY
# and DO NOT prefix it with NEXT_PUBLIC_ (keep it server-only).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
